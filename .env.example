# MediaGrab Backend Environment Variables
# Copy this file as .env and fill in your values

# Port (Render sets this automatically)
PORT=3001

# Your Netlify frontend URL (for CORS)
# Replace with your actual Netlify URL
FRONTEND_URL=https://your-site.netlify.app

# Max file size for downloads (in MB)
MAX_FILE_SIZE=500

# yt-dlp binary path (leave empty to use system default)
YTDLP_PATH=
